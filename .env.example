# SQLite file, resolved relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Desk login. Use a long password in production. There is no default.
ADMIN_PASSWORD=""
# Random string used to sign the desk cookie. Required for /admin.
ADMIN_SECRET=""

# Public site URL, no trailing slash. Used for metadata, sitemap, and email links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contact details shown on the site. Replace the placeholders before launch.
NEXT_PUBLIC_PHONE_DISPLAY="+27 21 000 0000"
NEXT_PUBLIC_PHONE_TEL="+27210000000"
NEXT_PUBLIC_WHATSAPP_NUMBER="27210000000"
NEXT_PUBLIC_CONTACT_EMAIL="hello@saltline.example"
# Leave blank until you have a real handle. A blank value hides the link.
NEXT_PUBLIC_INSTAGRAM=""

# Email. If either variable is empty, bookings still save and the server logs a stub.
# Resend needs a verified domain in EMAIL_FROM, for example:
# EMAIL_FROM="Saltline <bookings@yourdomain.com>"
RESEND_API_KEY=""
EMAIL_FROM=""

# Payment provider name for your own notes. Charging is not implemented.
# See lib/payments.ts before connecting Paystack, Stripe, or mobile money.
PAYMENT_PROVIDER=""

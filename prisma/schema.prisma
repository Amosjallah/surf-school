generator client {
  provider = "prisma-client-js"
}

// Supabase Postgres. DATABASE_URL is the transaction pooler (port 6543).
// DIRECT_URL is the session pooler (port 5432) used by prisma db push.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lesson {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  summary      String
  description  String
  durationMins Int
  priceCents   Int
  currency     String
  maxGroupSize Int
  skillLevel   String
  exclusive    Boolean   @default(false)
  includes     String
  sortOrder    Int
  active       Boolean   @default(true)
  bookings     Booking[]
}

model Slot {
  id          String    @id @default(cuid())
  date        String
  startTime   String
  capacity    Int
  bookedCount Int       @default(0)
  blocked     Boolean   @default(false)
  bookings    Booking[]

  @@unique([date, startTime])
  @@index([date])
}

model BlockedDate {
  date   String @id
  reason String
}

model Booking {
  id               String    @id @default(cuid())
  reference        String    @unique
  lessonId         String
  lesson           Lesson    @relation(fields: [lessonId], references: [id])
  slotId           String
  slot             Slot      @relation(fields: [slotId], references: [id])
  groupSize        Int
  spotsHeld        Int
  totalCents       Int
  currency         String
  name             String
  phone            String
  email            String
  skillLevel       String
  swimmingAbility  String
  medicalNotes     String    @default("")
  waiverAcceptedAt DateTime
  status           String    @default("confirmed")
  paymentStatus    String    @default("unpaid")
  createdAt        DateTime  @default(now())
  cancelledAt      DateTime?

  @@index([slotId, status])
}
